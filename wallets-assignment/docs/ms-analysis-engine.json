{
  "id": null,
  "title": "Spring Boot + Kafka + Postgres Metrics",
  "tags": ["spring", "kafka", "postgres", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "CPU Usage",
      "targets": [{ "expr": "process_cpu_usage" }],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "JVM Memory Used",
      "targets": [{ "expr": "jvm_memory_used_bytes{area=\"heap\"}" }],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests",
      "targets": [
        { "expr": "rate(http_server_requests_seconds_count[1m])", "legendFormat": "{{uri}}" }
      ],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 }
    },
    {
      "type": "stat",
      "title": "Total Actions",
      "targets": [{ "expr": "demo_actions_total" }],
      "gridPos": { "x": 0, "y": 10, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Kafka Messages In Per Second",
      "targets": [
        { "expr": "rate(kafka_server_brokertopicmetrics_messagesin_total[1m])", "legendFormat": "messages in" }
      ],
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Kafka Bytes In/Out",
      "targets": [
        { "expr": "rate(kafka_server_brokertopicmetrics_bytesin_total[1m])", "legendFormat": "bytes in" },
        { "expr": "rate(kafka_server_brokertopicmetrics_bytesout_total[1m])", "legendFormat": "bytes out" }
      ],
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Postgres Connections",
      "targets": [
        { "expr": "pg_stat_activity_count", "legendFormat": "connections" }
      ],
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Postgres Commits & Rollbacks",
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=\"postgres\"}[1m])", "legendFormat": "commits" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname=\"postgres\"}[1m])", "legendFormat": "rollbacks" }
      ],
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 6 }
    }
  ]
}
